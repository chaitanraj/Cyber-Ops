{
  "manifest_version": 3,
  "name": "Cyber-Ops Phishing Detector",
  "version": "1.0",
  "description": "Detect phishing URLs and protect your browsing",
 
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "contextMenus"
  ],
 
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "https://your-domain.com/*"
  ],
 
  "background": {
    "service_worker": "background.js"
  },
 
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}